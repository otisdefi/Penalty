# Contract addresses per network. Public addresses, not secrets. Set the same names in Vercel >
# Settings > Environment Variables. Every one is optional.
#
# Each test network has its own contracts, so its own leaderboard and its own online matches.
# A network with no address shows "Not available on this network yet" for that feature.

# Arc Testnet (chain ID 5042002). If missing, the app uses the contracts that are already deployed.
VITE_LEADERBOARD_ADDRESS_ARC=0x1df2ff3dd51acb1683781dd5d2808ca338047f4c
VITE_MATCH_ADDRESS_ARC=0x8093487cdfdcb6a31e371742a400ec203794c575

# Base Sepolia (chain ID 84532). No default in the code: set these two. These are the contracts deployed there.
VITE_LEADERBOARD_ADDRESS_BASE_SEPOLIA=0x9c6d4bb8e5df7d81c1bfae9d7a32f881c977d6a8
VITE_MATCH_ADDRESS_BASE_SEPOLIA=0x69f714d857b6b18d655fb739ecb60567957d18fb

# Which leaderboard contract is behind each address (optional, these are the defaults):
#   1 = recordMatch(won), the one deployed on Arc Testnet      2 = recordMatch(matchId, won), the one in contracts/ and on Base Sepolia
# VITE_LEADERBOARD_VERSION_ARC=1
# VITE_LEADERBOARD_VERSION_BASE_SEPOLIA=2

# Older names, still understood for Arc Testnet (used only when the _ARC variable above is not set).
# VITE_LEADERBOARD_ADDRESS=
# VITE_MATCH_ADDRESS=

# Optional: friend matches (Play a friend) connect players directly with WebRTC. Several public STUN servers
# are built in. Some mobile and office networks also need a TURN relay. Get one from a TURN provider (for
# example Cloudflare, Twilio or Metered) and set these three together. Anything starting with VITE_ is visible
# to players in the built app, so use browser-safe, usage-limited credentials, never an account master key.
# VITE_TURN_URLS=turn:relay.example.com:3478,turns:relay.example.com:443
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# Optional: your own PeerJS signaling server instead of the free PeerJS cloud.
# VITE_PEER_HOST=
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true

# Accounts and chat (Supabase). Both values are public by design; the database rules protect the data.
# Never put a service_role key here. Setup steps and the SQL are in supabase/README.md.
# Without these two, the app shows "Chat is not configured" and everything else works.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key (public) for bot protection on sign-up. Optional; see supabase/README.md.
VITE_TURNSTILE_SITE_KEY=
