# Address of the deployed PenaltyLeaderboard contract on Arc Testnet (chain ID 5042002).
# This is a public address, not a secret. Set the same name in Vercel > Settings > Environment Variables.
VITE_LEADERBOARD_ADDRESS=0x1df2ff3dd51acb1683781dd5d2808ca338047f4c

# Address of the deployed PenaltyMatch contract (online two-wallet matches) on Arc Testnet.
# Public address, not a secret. Set it in Vercel too.
VITE_MATCH_ADDRESS=0x8093487cdfdcb6a31e371742a400ec203794c575

# Optional: friend matches (Play a friend) connect players directly with WebRTC. Several public STUN servers
# are built in. Some mobile and office networks also need a TURN relay. Get one from a TURN provider (for
# example Cloudflare, Twilio or Metered) and set these three together. Anything starting with VITE_ is visible
# to players in the built app, so use browser-safe, usage-limited credentials, never an account master key.
# VITE_TURN_URLS=turn:relay.example.com:3478,turns:relay.example.com:443
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# Optional: your own PeerJS signaling server instead of the free PeerJS cloud.
# VITE_PEER_HOST=
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true

